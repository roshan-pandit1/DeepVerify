# Load from backend/.env or export these variables in every API/worker/CLI shell.
# Existing SQLite file: point this to the same database used by the legacy backend.
# This milestone supports SQLite only; this is a filesystem path, not a database URL.
INVESTIGATION_DB=deepfake.db
INVESTIGATION_ARTIFACTS=investigation-data
FRONTEND_URL=http://localhost:3000

# Existing SerpAPI integration reused for Google text search. No Brave key required.
SERPAPI_API_KEY=

# Generate locally; at least 24 characters. Never put this in frontend environment files.
INVESTIGATION_ADMIN_TOKEN=

# public-article fetches bounded public HTML; snippets-only records an explicit fallback.
SOURCE_EXTRACTION_PROVIDER=public-article
# Built-in conservative classifiers: guarded-rules (v2) or legacy (v1).
STANCE_CLASSIFIER=guarded-rules

# Shared workspace: local restricts API clients to loopback, even with a public bind.
# private requires a trusted gateway; it is NOT user/account isolation.
INVESTIGATION_DEPLOYMENT=local
INVESTIGATION_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# For private mode ONLY: exact gateway CIDRs, separate random token >=32 chars.
INVESTIGATION_TRUSTED_PROXY_CIDRS=
INVESTIGATION_WORKSPACE_TOKEN=

# SQLite-backed global limits: use the same values for API, worker and CLIs.
# Changing these on an existing DB requires python -m investigation.controls configure.
INVESTIGATION_LIMIT_REQUESTS_PER_MINUTE=300
INVESTIGATION_LIMIT_SUBMISSIONS_PER_HOUR=60
INVESTIGATION_LIMIT_QUEUE=100
INVESTIGATION_LIMIT_WORKERS=2
INVESTIGATION_LIMIT_ACTIVE_REQUESTS=8
INVESTIGATION_LIMIT_REQUEST_BYTES=65536
INVESTIGATION_LIMIT_CLAIM_CHARS=12000
INVESTIGATION_LIMIT_ASSERTIONS=20
INVESTIGATION_LIMIT_ASSERTION_CHARS=1500
INVESTIGATION_LIMIT_SEARCHES_PER_DAY=100
INVESTIGATION_LIMIT_SOURCES_PER_DAY=1000
# 0 disables ordinary live retrieval until YOU supply a per-attempt upper price bound.
# Pilot CLI requests additionally use their explicitly supplied unit-cost bound.
INVESTIGATION_SEARCH_UNIT_COST_USD=0
INVESTIGATION_DAILY_COST_USD=1
