# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram → get the token
# Get your Chat ID: message @userinfobot or check https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=8903990808:AAGhilCBHpI6u1K-hgqUJFgUJo_TcWQoWSk

# --- Database ---
# Option A: Local SQLite (development, zero setup)
DATABASE_URL=sqlite+aiosqlite:///./deepfake.db

# Option B: Supabase PostgreSQL (production — copy from Supabase Dashboard → Settings → Database → URI)
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Server URLs ---
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Optional: Fine-tuned EfficientNet-B4 weights ---
# MODEL_WEIGHTS_PATH=/path/to/efficientnet_b4_deepfake.pth

# --- Yt-Dlp Authentication ---
# (Optional) If you want your backend to access login-gated videos, export your session cookies using a browser extension (like Get cookies.txt LOCALLY) and save the file as backend/cookies.txt
# COOKIES_FILE_PATH=backend/cookies.txt

# --- Limits ---
MAX_VIDEO_SIZE_MB=500
FRAME_SAMPLE_RATE=1

# --- Anthropic (only needed if LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Blockchain Provenance & Chain-of-Custody (all optional — graceful fallback)
# =============================================================================

# --- Blockchain Network ---
# Default: Polygon Amoy testnet. Swap to Ethereum Sepolia if preferred:
#   BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
#   BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
BLOCK_EXPLORER_URL=https://amoy.polygonscan.com

# --- Signing Wallet ---
# Hex private key (0x-prefixed) of the hot-wallet that will sign attestation
# transactions. Must hold testnet MATIC (Polygon Amoy faucet: faucet.polygon.technology)
# WALLET_PRIVATE_KEY=0xabc123...

# --- Deployed Contract ---
# Address of your deployed MediaProvenanceRegistry.sol contract.
# Deploy guide: see contracts/MediaProvenanceRegistry.sol
# CONTRACT_ADDRESS=0xYourDeployedContractAddress

# --- Pinata (IPFS Pinning) ---
# Create a free account at https://app.pinata.cloud/
# Then generate API Keys under Developers → API Keys
# PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET_API_KEY=your_pinata_secret_api_key
